{
  "name": "dsh-quota",
  "version": "0.1.0",
  "description": "Wakes a DeepSeek Harness agent when its MiniMax usage window resets",
  "license": "MIT",
  "author": "johnlam1968",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnlam1968/dsh-quota.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "minimax",
    "quota"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && rm -rf lib/types && tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@types/node": "^22.20.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
